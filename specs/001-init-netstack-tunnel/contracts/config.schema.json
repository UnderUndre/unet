{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unet.dev/schemas/001-init-netstack-tunnel/config.schema.json",
  "title": "unet TunnelConfig",
  "description": "Local JSON config for the embedded AmneziaWG netstack core (FR-003, FR-008). Authoritative schema for data-model.md §1.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "hostPort": {
      "type": "string",
      "description": "host:port with port 1-65535; IPv6 literals must be bracketed.",
      "pattern": "^([A-Za-z0-9.-]+|\\[[0-9A-Fa-f:.]+\\]):([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    }
  },
  "required": ["public_key", "peer", "obfuscation", "resolution_mode"],
  "allOf": [
    {
      "if": {
        "properties": { "resolution_mode": { "const": "tunnel_dns" } },
        "required": ["resolution_mode"]
      },
      "then": {
        "required": ["dns"],
        "properties": { "dns": { "minItems": 1 } }
      }
    }
  ],
  "properties": {
    "private_key": {
      "type": "string",
      "description": "Client WG private key (base64). Auto-generated on first run if absent (FR-008). MAY be omitted here and supplied via UNET_PRIVATE_KEY. PLAINTEXT-AT-REST when present (FR-008.001); file MUST be 0600/owner-only (FR-008.002/.003).",
      "pattern": "^[A-Za-z0-9+/]{42,44}={0,2}$"
    },
    "public_key": {
      "type": "string",
      "description": "Client WG public key (base64). Sole tunnel identity to the gateway (FR-006).",
      "pattern": "^[A-Za-z0-9+/]{42,44}={0,2}$"
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_key", "endpoint", "allowed_ips"],
      "properties": {
        "public_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{42,44}={0,2}$" },
        "endpoint": {
          "$ref": "#/$defs/hostPort",
          "description": "Exit endpoint host:port; host MAY be a DNS name and is re-resolved on roaming (FR-007.002)."
        },
        "allowed_ips": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "preshared_key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{42,44}={0,2}$" },
        "persistent_keepalive": { "type": "integer", "minimum": 0 }
      }
    },
    "obfuscation": {
      "type": "object",
      "description": "AmneziaWG DPI-evasion parameters (FR-003).",
      "additionalProperties": false,
      "required": ["jc", "jmin", "jmax", "s1", "s2", "h1", "h2", "h3", "h4"],
      "properties": {
        "jc": { "type": "integer", "minimum": 0 },
        "jmin": { "type": "integer", "minimum": 0 },
        "jmax": { "type": "integer", "minimum": 0 },
        "s1": { "type": "integer", "minimum": 0 },
        "s2": { "type": "integer", "minimum": 0 },
        "h1": { "type": "integer" },
        "h2": { "type": "integer" },
        "h3": { "type": "integer" },
        "h4": { "type": "integer" }
      }
    },
    "resolution_mode": {
      "type": "string",
      "enum": ["remote", "tunnel_dns"],
      "description": "Explicit anti-leak DNS mode. 'remote' forwards names to the exit; 'tunnel_dns' requires dns resolver IPs reachable inside the tunnel (FR-009)."
    },
    "dns": {
      "type": "array",
      "description": "Tunnel-side resolver IP(s) reachable inside the tunnel (FR-009). Required when resolution_mode=tunnel_dns.",
      "items": {
        "anyOf": [
          { "type": "string", "format": "ipv4" },
          { "type": "string", "format": "ipv6" }
        ]
      }
    },
    "mtu": {
      "type": "integer",
      "description": "Tunnel MTU (FR-010). Default computed from obfuscation overhead; MSS clamping applied at the netstack edge.",
      "minimum": 576,
      "maximum": 1500
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": { "type": "string", "default": "127.0.0.1:1080" },
        "auth_enabled": { "type": "boolean", "default": false },
        "username": { "type": "string" },
        "password": { "type": "string", "description": "Secret-bearing. If present, config file MUST be owner-only; prefer password_env on shared hosts." },
        "password_env": { "type": "string", "description": "Environment variable name containing the proxy password." },
        "shared_host": {
          "type": "boolean",
          "default": false,
          "description": "If true, refuse to start unauthenticated (FR-004 multi-user caveat)."
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/$defs/hostPort", "description": "Tunnel-internal gateway TCP host:port for the single long-lived yamux session." },
        "capability_token": { "type": "string", "description": "Optional per-tunnel token, first yamux control frame (FR-006.002). Secret-bearing; prefer capability_token_env." },
        "capability_token_env": { "type": "string", "description": "Environment variable name containing the gateway capability token." },
        "allow_list": {
          "type": "array",
          "description": "Default-deny reverse-forward authorization (FR-006.001). Empty/absent => no reverse-forward permitted.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["public_port", "local_host", "local_port"],
            "properties": {
              "public_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "local_host": { "type": "string", "description": "No wildcards." },
              "local_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    },
    "reconnect": {
      "type": "object",
      "additionalProperties": false,
      "description": "Backoff, liveness and terminal-failure knobs (FR-007).",
      "anyOf": [
        { "required": ["max_total_duration_ms"] },
        { "required": ["max_attempts"] },
        { "properties": { "retry_forever": { "const": true } }, "required": ["retry_forever"] }
      ],
      "properties": {
        "initial_backoff_ms": { "type": "integer", "minimum": 0 },
        "max_backoff_ms": { "type": "integer", "minimum": 0 },
        "jitter": { "type": "boolean", "default": true },
        "max_total_duration_ms": { "type": "integer", "minimum": 1, "description": "Finite terminal-failure give-up duration (FR-007.004)." },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "retry_forever": { "type": "boolean", "default": false, "description": "Explicit infinite-retry opt-in. Keeps health degraded and emits periodic warnings." },
        "keepalive_interval_ms": { "type": "integer", "minimum": 0 },
        "keepalive_timeout_ms": { "type": "integer", "minimum": 0 },
        "dial_timeout_ms": { "type": "integer", "minimum": 0, "description": "SOCKS5 outbound connect timeout (FR-007.005)." }
      }
    }
  }
}
